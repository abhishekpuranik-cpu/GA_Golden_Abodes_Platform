MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=ga-platform
MONGODB_DB_NAME=golden_abodes
PORT=3020

# Local dev only — skip login (never works when NODE_ENV=production)
DEV_BYPASS_AUTH=0

# Optional — Hiring Metaview auto-sourcing (set on Render for production sync)
# ANTHROPIC_API_KEY=   # not required for direct MCP sync
METAVIEW_OAUTH_TOKEN=
METAVIEW_MCP_URL=https://mcp.metaview.ai/mcp

API_TOOL_PATH=C:\Users\HP\OneDrive\Projects\API\API_Tool

# Vault → external React apps (Production: set on Render for the *platform* service — no redeploy if you use EXECUTION_* names)
# EXECUTION_DASHBOARD_URL=https://your-execution-app.onrender.com
# PRECONSTRUCTION_APP_URL=https://your-preconstruction-static.onrender.com
# V2V3_ACCESS_CODE=share-this-code-with-authorized-users-only
#
# Optional dev: copy into client/.env.development
# VITE_EXECUTION_DASHBOARD_URL=http://127.0.0.1:5173
# VITE_PRECONSTRUCTION_URL=http://127.0.0.1:5181
#
# PreConstruction email notifications (primary channel — same content as WhatsApp alerts)
# Option A — Resend (recommended if you have DNS for goldenabodes.com):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# PRECON_NOTIFY_FROM=Golden Abodes <notifications@goldenabodes.com>
#
# Option B — Google Apps Script relay (no DNS changes; uses your Gmail/Workspace):
# EMAIL_PROVIDER=gas
# PRECON_GAS_EMAIL_URL=https://script.google.com/macros/s/.../exec
# PRECON_GAS_EMAIL_SECRET=long-random-secret
# PRECON_NOTIFY_FROM=Golden Abodes PreConstruction
#
# Optional: Twilio WhatsApp (off by default — set to 1 only if sandbox/production WA is ready)
# PRECON_NOTIFY_WHATSAPP=1
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
