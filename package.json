{
  "name": "ga-golden-abodes-platform",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "build": "vite build --config client/vite.config.js",
    "sync-v1": "node scripts/sync-v1-cashflow.mjs",
    "build:all": "node scripts/sync-v1-cashflow.mjs && vite build --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "xlsx": "^0.18.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}

