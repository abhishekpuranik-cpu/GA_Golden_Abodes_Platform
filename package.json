{
  "name": "ga-golden-abodes-platform",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "git:track-app-states-imports": "node scripts/git-track-app-states-imports.mjs --fix",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "build": "vite build --config client/vite.config.js",
    "import:v1-cf": "node scripts/import-v1-cashflow-to-mongo.mjs",
    "sync-v1": "node scripts/sync-v1-cashflow.mjs",
    "sync-legacy": "node scripts/sync-legacy-html.mjs",
    "build:ga-acct": "node scripts/build-ga-accounting-categories-js.mjs",
    "build:all": "node scripts/build-ga-accounting-categories-js.mjs && node scripts/sync-v1-cashflow.mjs && node scripts/sync-legacy-html.mjs && vite build --config client/vite.config.js",
    "build:precon": "node scripts/build-preconstruction.mjs",
    "build:render": "node scripts/build-preconstruction.mjs && vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed:postsales": "node server/seeds/postsales.js"
  },
  "dependencies": {
    "bson": "^6.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongodb": "^6.21.0",
    "mongoose": "^9.7.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.16",
    "pptxgenjs": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
